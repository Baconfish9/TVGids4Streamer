<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: niets meenemen in een back-up of bij het overzetten naar een nieuw toestel.
  allowBackup="false" alleen houdt dat overzetten niet tegen. De app bewaart enkel de
  gids-cache, die na installatie gewoon opnieuw wordt opgehaald.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
